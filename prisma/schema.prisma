generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Favorite {
  id           String   @id @default(cuid())
  clerkUserId  String
  sanityId     String
  createdAt    DateTime @default(now())

  @@unique([clerkUserId, sanityId], name: "clerkUserId_sanityId")
}